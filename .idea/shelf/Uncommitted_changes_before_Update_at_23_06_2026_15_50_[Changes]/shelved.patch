+        <p class="ok">✅ Connessione al DB riuscita!
+            Trovati <strong>${prodotti.size()}</strong> prodotti.</p>
+
+        <table>
+            <thead>
+            <tr>
+                <th>ID</th>
+                <th>Nome</th>
+                <th>Categoria</th>
+                <th>Prezzo</th>
+                <th>IVA</th>
+                <th>Stock</th>
+            </tr>
